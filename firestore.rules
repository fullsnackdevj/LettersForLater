rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pairs: authenticated users can create pairs, members can read/update
    match /pairs/{pairId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null 
        && (resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid);
    }

    // Letters: only pair members can read/write letters
    match /pairs/{pairId}/letters/{letterId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }
  }
}
